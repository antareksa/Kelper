[Unit]
Description=KELPER backend (staging)
After=network.target

[Service]
Type=simple
Environment=NODE_ENV=production
Environment=PORT=3002
WorkingDirectory={{APP_DIR}}/kelper-backend
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
User={{SERVICE_USER}}
Group={{SERVICE_GROUP}}

[Install]
WantedBy=multi-user.target
